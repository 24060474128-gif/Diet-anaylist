<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Nutrisi & Kebugaran - Bu Lia</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Google Fonts Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f0fdf4',
              100: '#dcfce7',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
              800: '#166534',
              900: '#14532d',
            }
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .tab-active {
      background-color: #16a34a;
      color: #ffffff !important;
      box-shadow: 0 4px 6px -1px rgba(22, 163, 74, 0.3);
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col md:flex-row">

  <!-- SIDEBAR NAVIGATION -->
  <aside class="w-full md:w-64 bg-slate-900 text-slate-300 flex-shrink-0 flex flex-col justify-between border-r border-slate-800">
    <div>
      <!-- Brand Logo & Title -->
      <div class="p-5 border-b border-slate-800 flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-emerald-400 flex items-center justify-center text-white font-bold shadow-lg">
          <i data-lucide="activity" class="w-6 h-6"></i>
        </div>
        <div>
          <h1 class="font-bold text-white text-base leading-tight">NutriFit Pro</h1>
          <p class="text-xs text-slate-400">Sports Nutrition System</p>
        </div>
      </div>

      <!-- Client Quick Profile -->
      <div class="p-4 mx-3 my-4 bg-slate-800/80 rounded-xl border border-slate-700/60">
        <div class="flex items-center space-x-3">
          <div class="w-11 h-11 rounded-full bg-slate-700 flex items-center justify-center text-brand-400 font-bold border-2 border-brand-500/30">
            BL
          </div>
          <div>
            <h2 class="font-semibold text-white text-sm">Bu Lia</h2>
            <p class="text-xs text-slate-400">54 Tahun • 155 cm • 58 kg</p>
            <span class="inline-block mt-1 px-2 py-0.5 text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-full">
              Healthy Aging & Active
            </span>
          </div>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="px-3 space-y-1">
        <button onclick="switchTab('overview')" id="nav-overview" class="tab-button tab-active w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all text-slate-300 hover:bg-slate-800 hover:text-white">
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
          <span>Dashboard Utama</span>
        </button>
        <button onclick="switchTab('monitoring')" id="nav-monitoring" class="tab-button w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all text-slate-300 hover:bg-slate-800 hover:text-white">
          <i data-lucide="calendar" class="w-4 h-4"></i>
          <span>Monitoring Harian</span>
        </button>
        <button onclick="switchTab('antropometri')" id="nav-antropometri" class="tab-button w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all text-slate-300 hover:bg-slate-800 hover:text-white">
          <i data-lucide="scale" class="w-4 h-4"></i>
          <span>Profil & Antropometri</span>
        </button>
        <button onclick="switchTab('program')" id="nav-program" class="tab-button w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all text-slate-300 hover:bg-slate-800 hover:text-white">
          <i data-lucide="dumbbell" class="w-4 h-4"></i>
          <span>Program Latihan</span>
        </button>
        <button onclick="switchTab('rekomendasi')" id="nav-rekomendasi" class="tab-button w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all text-slate-300 hover:bg-slate-800 hover:text-white">
          <i data-lucide="utensils" class="w-4 h-4"></i>
          <span>Rekomendasi Diet</span>
        </button>
      </nav>
    </div>

    <!-- Sports Nutritionist Footer Info -->
    <div class="p-4 border-t border-slate-800 text-xs text-slate-500">
      <div class="flex items-center space-x-2 text-slate-400 font-medium mb-1">
        <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i>
        <span>Evidence-Based Practice</span>
      </div>
      <p>Mifflin-St Jeor Formula • ESPEN / PROT-AGE Guidelines</p>
    </div>
  </aside>

  <!-- MAIN CONTENT AREA -->
  <main class="flex-1 overflow-y-auto flex flex-col">
    
    <!-- TOP HEADER BAR -->
    <header class="bg-white border-b border-slate-200 px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 sticky top-0 z-10 shadow-sm">
      <div>
        <h1 id="page-title" class="text-xl font-bold text-slate-900">Dashboard Utama</h1>
        <p class="text-xs text-slate-500">Analisis Pemantauan Nutrisi & Komposisi Tubuh Real-time</p>
      </div>

      <div class="flex items-center space-x-3">
        <button onclick="openAddModal()" class="flex items-center space-x-2 bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-all shadow-md shadow-brand-600/20 active:scale-95">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span>Catat Log Harian</span>
        </button>
      </div>
    </header>

    <!-- CONTENT BODY CONTAINER -->
    <div class="p-6 space-y-6 flex-1">

      <!-- ALERT BANNER FOR CALORIC DEFICIT STATUS -->
      <div id="alert-banner" class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-start space-x-3">
          <div class="p-2 bg-amber-100 text-amber-700 rounded-lg flex-shrink-0 mt-0.5 sm:mt-0">
            <i data-lucide="alert-triangle" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-semibold text-amber-900 text-sm">Peringatan Klinis: Asupan Kalori Berada di Bawah BMR</h3>
            <p class="text-xs text-amber-800 mt-0.5">
              Rata-rata asupan saat ini (<span id="banner-avg-cal" class="font-bold">1,011 kkal</span>) berada di bawah BMR Bu Lia (<span class="font-bold">1,118 kkal</span>). Disarankan untuk menaikkan asupan bertahap menuju target <span class="font-bold">1,473 kkal</span> guna mencegah penurunan massa otot dan adaptasi metabolik.
            </p>
          </div>
        </div>
        <button onclick="switchTab('rekomendasi')" class="text-xs font-semibold bg-amber-200 hover:bg-amber-300 text-amber-900 px-3 py-1.5 rounded-lg transition flex-shrink-0 self-end sm:self-center">
          Lihat Solusi Menu
        </button>
      </div>

      <!-- TAB 1: OVERVIEW DASHBOARD -->
      <section id="tab-overview" class="tab-content space-y-6">
        
        <!-- TOP KPI CARDS GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <!-- Card 1: Target vs Actual Calories -->
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Rata-rata Kalori</span>
              <div class="w-8 h-8 rounded-lg bg-orange-50 text-orange-600 flex items-center justify-center">
                <i data-lucide="flame" class="w-4 h-4"></i>
              </div>
            </div>
            <div class="mt-3">
              <div class="text-2xl font-bold text-slate-900" id="kpi-avg-cal">1,011 <span class="text-xs text-slate-500 font-normal">kkal</span></div>
              <div class="text-xs text-slate-500 mt-1 flex items-center justify-between">
                <span>Target: 1,473 kkal</span>
                <span class="font-medium text-amber-600" id="kpi-cal-pct">68.6%</span>
              </div>
              <div class="w-full bg-slate-100 h-2 rounded-full mt-2 overflow-hidden">
                <div id="bar-cal-pct" class="bg-amber-500 h-full rounded-full" style="width: 68.6%"></div>
              </div>
            </div>
          </div>

          <!-- Card 2: Protein Intake -->
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Rata-rata Protein</span>
              <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i data-lucide="beef" class="w-4 h-4"></i>
              </div>
            </div>
            <div class="mt-3">
              <div class="text-2xl font-bold text-slate-900" id="kpi-avg-protein">59.5 <span class="text-xs text-slate-500 font-normal">gram</span></div>
              <div class="text-xs text-slate-500 mt-1 flex items-center justify-between">
                <span>Target: 92.8 gram</span>
                <span class="font-medium text-emerald-600" id="kpi-protein-pct">64.1%</span>
              </div>
              <div class="w-full bg-slate-100 h-2 rounded-full mt-2 overflow-hidden">
                <div id="bar-protein-pct" class="bg-emerald-500 h-full rounded-full" style="width: 64.1%"></div>
              </div>
            </div>
          </div>

          <!-- Card 3: Hydration Average -->
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Asupan Cairan</span>
              <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                <i data-lucide="droplets" class="w-4 h-4"></i>
              </div>
            </div>
            <div class="mt-3">
              <div class="text-2xl font-bold text-slate-900" id="kpi-avg-water">2.6 <span class="text-xs text-slate-500 font-normal">Liter</span></div>
              <div class="text-xs text-slate-500 mt-1 flex items-center justify-between">
                <span>Target Min: 2.5 L</span>
                <span class="font-medium text-emerald-600">Optimal</span>
              </div>
              <div class="w-full bg-slate-100 h-2 rounded-full mt-2 overflow-hidden">
                <div class="bg-blue-500 h-full rounded-full" style="width: 100%"></div>
              </div>
            </div>
          </div>

          <!-- Card 4: Average Sleep & Recovery -->
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Durasi Tidur</span>
              <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                <i data-lucide="moon" class="w-4 h-4"></i>
              </div>
            </div>
            <div class="mt-3">
              <div class="text-2xl font-bold text-slate-900" id="kpi-avg-sleep">6.4 <span class="text-xs text-slate-500 font-normal">Jam</span></div>
              <div class="text-xs text-slate-500 mt-1 flex items-center justify-between">
                <span>Target: 7.0 - 8.0 jam</span>
                <span class="font-medium text-indigo-600" id="kpi-sleep-status">Cukup</span>
              </div>
              <div class="w-full bg-slate-100 h-2 rounded-full mt-2 overflow-hidden">
                <div id="bar-sleep-pct" class="bg-indigo-500 h-full rounded-full" style="width: 80%"></div>
              </div>
            </div>
          </div>

        </div>

        <!-- CHARTS SECTION GRID -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          <!-- Chart 1: Daily Caloric Intake vs BMR vs Target (2 Cols) -->
          <div class="lg:col-span-2 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="font-bold text-slate-900 text-base">Tren Kalori Harian vs Ambang BMR</h3>
                <p class="text-xs text-slate-500">Garis merah melambangkan BMR (1,118 kkal), garis hijau adalah Target Defisit (1,473 kkal)</p>
              </div>
              <span class="px-2.5 py-1 text-xs font-medium bg-slate-100 text-slate-700 rounded-lg">7 Hari Terakhir</span>
            </div>
            <div class="h-64 sm:h-72">
              <canvas id="caloriesChart"></canvas>
            </div>
          </div>

          <!-- Chart 2: Macro & Protein Compliance -->
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-bold text-slate-900 text-base">Kepatuhan Protein</h3>
                <div class="p-1.5 bg-emerald-50 text-emerald-600 rounded-md">
                  <i data-lucide="target" class="w-4 h-4"></i>
                </div>
              </div>
              <p class="text-xs text-slate-500 mb-4">Pencapaian protein harian terhadap target 92.8 gram</p>
              <div class="h-48 relative flex items-center justify-center">
                <canvas id="proteinGaugeChart"></canvas>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-600 space-y-2">
              <div class="flex justify-between">
                <span>Rata-rata Terukur:</span>
                <span class="font-bold text-slate-800" id="gauge-current-text">59.5 g / hari</span>
              </div>
              <div class="flex justify-between">
                <span>Rekomendasi Tambahan:</span>
                <span class="font-bold text-emerald-600">+33.3 g / hari</span>
              </div>
            </div>
          </div>

        </div>

        <!-- SECONDARY CHARTS GRID -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          
          <!-- Activity & Workout Duration Chart -->
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="font-bold text-slate-900 text-base">Aktivitas Fisik & Intensitas (RPE)</h3>
                <p class="text-xs text-slate-500">Durasi latihan kardio/strength dan tingkat kelelahan</p>
              </div>
            </div>
            <div class="h-60">
              <canvas id="activityChart"></canvas>
            </div>
          </div>

          <!-- Hydration & Sleep Correlation Chart -->
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="font-bold text-slate-900 text-base">Hidrasi vs Pemulihan Tidur</h3>
                <p class="text-xs text-slate-500">Hubungan konsumsi air putih dan jam tidur malam</p>
              </div>
            </div>
            <div class="h-60">
              <canvas id="recoveryChart"></canvas>
            </div>
          </div>

        </div>

      </section>

      <!-- TAB 2: MONITORING HARIAN (TABLE VIEW) -->
      <section id="tab-monitoring" class="tab-content hidden space-y-6">
        
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          
          <div class="p-5 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/50">
            <div>
              <h3 class="font-bold text-slate-900 text-base">Catatan Log Harian Bu Lia</h3>
              <p class="text-xs text-slate-500">Data konsumsi, olahraga, hidrasi, dan tingkat pemulihan</p>
            </div>
            <button onclick="openAddModal()" class="flex items-center space-x-2 bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-lg text-xs font-semibold transition">
              <i data-lucide="plus" class="w-4 h-4"></i>
              <span>Tambah Baris Data</span>
            </button>
          </div>

          <!-- TABLE CONTAINER -->
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-100/80 text-slate-600 font-semibold uppercase tracking-wider border-b border-slate-200 text-[11px]">
                  <th class="py-3 px-4">Tanggal</th>
                  <th class="py-3 px-4">BB (kg)</th>
                  <th class="py-3 px-4">Kalori (kkal)</th>
                  <th class="py-3 px-4">Protein (g)</th>
                  <th class="py-3 px-4">Air (L)</th>
                  <th class="py-3 px-4">Tidur</th>
                  <th class="py-3 px-4">Latihan</th>
                  <th class="py-3 px-4">Durasi</th>
                  <th class="py-3 px-4">RPE</th>
                  <th class="py-3 px-4">Catatan / Evaluasi</th>
                </tr>
              </thead>
              <tbody id="monitoring-table-body" class="divide-y divide-slate-200 text-slate-700">
                <!-- Dynamic rows populated via JS -->
              </tbody>
            </table>
          </div>

          <div class="p-4 border-t border-slate-200 bg-slate-50 text-xs text-slate-500 flex justify-between items-center">
            <span id="table-row-count">Menampilkan 4 entri catatan</span>
            <span class="text-slate-400">Diperbarui real-time</span>
          </div>

        </div>

      </section>

      <!-- TAB 3: PROFIL & ANTROPOMETRI -->
      <section id="tab-antropometri" class="tab-content hidden space-y-6">
        
        <!-- BMR & TDEE CALCULATION SUMMARY -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white p-6 rounded-2xl shadow-md space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-lg text-emerald-400">Mifflin-St Jeor Formula</h3>
              <i data-lucide="calculator" class="w-5 h-5 text-emerald-400"></i>
            </div>
            <div class="space-y-2 text-xs text-slate-300">
              <p><span class="text-slate-400">Jenis Kelamin:</span> Wanita (54 Th)</p>
              <p><span class="text-slate-400">Berat Badan:</span> 58.0 kg</p>
              <p><span class="text-slate-400">Tinggi Badan:</span> 155.0 cm</p>
              <div class="border-t border-slate-700 pt-2 mt-2">
                <div class="text-slate-400">BMR (Metabolisme Basal):</div>
                <div class="text-2xl font-bold text-white mt-1">1,117.75 <span class="text-xs font-normal">kkal/hari</span></div>
              </div>
            </div>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-900">Total Energy Expenditure</h3>
              <i data-lucide="zap" class="w-5 h-5 text-amber-500"></i>
            </div>
            <div class="space-y-2 text-xs text-slate-600">
              <p><span class="font-medium">Faktor Aktivitas:</span> 1.55 (Sedang - Kardio 2x/mgg)</p>
              <p><span class="font-medium">BMR x Aktivitas:</span> 1,117.75 x 1.55</p>
              <div class="border-t border-slate-100 pt-2 mt-2">
                <div class="text-slate-500">TDEE (Pemeliharaan):</div>
                <div class="text-2xl font-bold text-slate-900 mt-1">1,732.51 <span class="text-xs font-normal text-slate-500">kkal/hari</span></div>
              </div>
            </div>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-900">Target Defisit Konservatif</h3>
              <i data-lucide="shield" class="w-5 h-5 text-emerald-600"></i>
            </div>
            <div class="space-y-2 text-xs text-slate-600">
              <p><span class="font-medium">Defisit Awal:</span> 15% dari TDEE</p>
              <p><span class="font-medium">Target Protein:</span> 1.6 g / kg BB (92.8g)</p>
              <div class="border-t border-slate-100 pt-2 mt-2">
                <div class="text-slate-500">Target Asupan Harian:</div>
                <div class="text-2xl font-bold text-emerald-600 mt-1">1,472.64 <span class="text-xs font-normal text-slate-500">kkal/hari</span></div>
              </div>
            </div>
          </div>

        </div>

        <!-- MEASUREMENT TABLE & HEALTH INDICES -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          <div class="lg:col-span-2 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <h3 class="font-bold text-slate-900 text-base mb-3">Pengukuran Antropometri Baseline</h3>
            <p class="text-xs text-slate-500 mb-4">Dievaluasi ulang setiap 2-4 minggu pada kondisi terstandardisasi (pagi hari)</p>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                <span class="text-[11px] text-slate-500 uppercase font-medium">Lingkar Pinggang</span>
                <div class="text-lg font-bold text-slate-800 mt-1">80.0 cm</div>
              </div>
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                <span class="text-[11px] text-slate-500 uppercase font-medium">Lingkar Perut</span>
                <div class="text-lg font-bold text-slate-800 mt-1">85.0 cm</div>
              </div>
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                <span class="text-[11px] text-slate-500 uppercase font-medium">Lingkar Pinggul</span>
                <div class="text-lg font-bold text-slate-800 mt-1">95.0 cm</div>
              </div>
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                <span class="text-[11px] text-slate-500 uppercase font-medium">Lingkar Dada</span>
