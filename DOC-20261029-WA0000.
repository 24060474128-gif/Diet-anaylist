  <!-- JAVASCRIPT LOGIC -->
  <script>
    // --- GLOBAL DATA STATE (INITIALIZED FROM BU LIA'S EXCEL FILE) ---
    const clientTargets = {
      bmr: 1117.75,
      tdee: 1732.51,
      targetCal: 1472.64,
      targetProtein: 92.8,
      waterMin: 2.5,
      sleepTarget: 7.5
    };

    let logData = [
      { tanggal: '2026-10-25', bb: 58.0, kalori: 970, protein: 62, air: 2.5, tidur: 5.0, latihanType: 'Tidak', durasi: 0, rpe: 0, catatan: 'Masih terasa DOMS' },
      { tanggal: '2026-10-26', bb: null, kalori: 1100, protein: 70, air: 2.5, tidur: 5.0, latihanType: 'Kardio', durasi: 30, rpe: 7, catatan: 'Senam Aerobik 30 menit' },
      { tanggal: '2026-10-27', bb: null, kalori: 985, protein: 46, air: 2.6, tidur: 7.5, latihanType: 'Kardio', durasi: 60, rpe: 7, catatan: 'Renang' },
      { tanggal: '2026-10-28', bb: null, kalori: 990, protein: 60, air: 2.8, tidur: 8.0, latihanType: 'Kardio', durasi: 30, rpe: 4, catatan: 'Jalan Kaki 2.267 langkah' }
    ];

    // CHART INSTANCES
    let caloriesChartInstance = null;
    let proteinGaugeChartInstance = null;
    let activityChartInstance = null;
    let recoveryChartInstance = null;

    // INITIALIZATION ON WINDOW LOAD
    window.onload = function() {
      lucide.createIcons();
      updateDashboardData();
      renderCharts();
      renderMonitoringTable();
      
      // Set default input date in form to today
      document.getElementById('input-tanggal').value = new Date().toISOString().split('T')[0];
    };

    // TAB SWITCHING LOGIC
    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-button').forEach(el => {
        el.classList.remove('tab-active');
        el.classList.add('text-slate-300');
      });

      document.getElementById(`tab-${tabId}`).classList.remove('hidden');
      const activeNav = document.getElementById(`nav-${tabId}`);
      if(activeNav) {
        activeNav.classList.add('tab-active');
        activeNav.classList.remove('text-slate-300');
      }

      // Update Page Header Title
      const titles = {
        overview: 'Dashboard Utama',
        monitoring: 'Monitoring Harian',
        antropometri: 'Profil & Antropometri',
        program: 'Program Latihan Mingguan',
        rekomendasi: 'Rekomendasi Diet & Nutrisi'
      };
      document.getElementById('page-title').innerText = titles[tabId] || 'Dashboard';
    }

    // CALCULATE AVERAGES AND UPDATE KPIS
    function updateDashboardData() {
      const avgCal = Math.round(logData.reduce((acc, d) => acc + d.kalori, 0) / logData.length);
      const avgProtein = (logData.reduce((acc, d) => acc + d.protein, 0) / logData.length).toFixed(1);
      const avgWater = (logData.reduce((acc, d) => acc + d.air, 0) / logData.length).toFixed(1);
      const avgSleep = (logData.reduce((acc, d) => acc + d.tidur, 0) / logData.length).toFixed(1);

      // Calorie KPI
      document.getElementById('kpi-avg-cal').innerHTML = `${avgCal.toLocaleString()} <span class="text-xs text-slate-500 font-normal">kkal</span>`;
      const calPct = Math.min(100, ((avgCal / clientTargets.targetCal) * 100)).toFixed(1);
      document.getElementById('kpi-cal-pct').innerText = `${calPct}%`;
      document.getElementById('bar-cal-pct').style.width = `${calPct}%`;
      document.getElementById('banner-avg-cal').innerText = `${avgCal.toLocaleString()} kkal`;

      // Protein KPI
      document.getElementById('kpi-avg-protein').innerHTML = `${avgProtein} <span class="text-xs text-slate-500 font-normal">gram</span>`;
      const proteinPct = Math.min(100, ((avgProtein / clientTargets.targetProtein) * 100)).toFixed(1);
      document.getElementById('kpi-protein-pct').innerText = `${proteinPct}%`;
      document.getElementById('bar-protein-pct').style.width = `${proteinPct}%`;
      document.getElementById('gauge-current-text').innerText = `${avgProtein} g / hari`;

      // Water KPI
      document.getElementById('kpi-avg-water').innerHTML = `${avgWater} <span class="text-xs text-slate-500 font-normal">Liter</span>`;

      // Sleep KPI
      document.getElementById('kpi-avg-sleep').innerHTML = `${avgSleep} <span class="text-xs text-slate-500 font-normal">Jam</span>`;
    }

    // RENDER TABLE ROWS DYNAMICALLY
    function renderMonitoringTable() {
      const tbody = document.getElementById('monitoring-table-body');
      tbody.innerHTML = '';

      logData.forEach((row) => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 transition border-b border-slate-100';

        const calWarningClass = row.kalori < clientTargets.bmr ? 'bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded' : 'font-medium text-slate-800';
        const proteinClass = row.protein < 81.2 ? 'text-amber-600 font-semibold' : 'text-emerald-600 font-semibold';
        
        tr.innerHTML = `
          <td class="py-3 px-4 font-medium text-slate-800">${row.tanggal}</td>
          <td class="py-3 px-4">${row.bb ? row.bb + ' kg' : '-'}</td>
          <td class="py-3 px-4"><span class="${calWarningClass}">${row.kalori} kkal</span></td>
          <td class="py-3 px-4"><span class="${proteinClass}">${row.protein} g</span></td>
          <td class="py-3 px-4">${row.air} L</td>
          <td class="py-3 px-4">${row.tidur} jam</td>
          <td class="py-3 px-4"><span class="px-2 py-0.5 rounded text-[11px] font-medium ${row.latihanType === 'Kardio' ? 'bg-blue-100 text-blue-800' : row.latihanType === 'Strength' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600'}">${row.latihanType}</span></td>
          <td class="py-3 px-4">${row.durasi > 0 ? row.durasi + ' mnt' : '-'}</td>
          <td class="py-3 px-4">${row.rpe > 0 ? 'RPE ' + row.rpe : '-'}</td>
          <td class="py-3 px-4 text-xs text-slate-500">${row.catatan || '-'}</td>
        `;
        tbody.appendChild(tr);
      });

      document.getElementById('table-row-count').innerText = `Menampilkan ${logData.length} entri catatan`;
    }

    // CHART RENDERING (CHART.JS)
    function renderCharts() {
      const labels = logData.map(d => d.tanggal.substring(5)); // Extract MM-DD
      const calories = logData.map(d => d.kalori);
      const proteins = logData.map(d => d.protein);
      const durations = logData.map(d => d.durasi);
      const rpes = logData.map(d => d.rpe);
      const waters = logData.map(d => d.air);
      const sleeps = logData.map(d => d.tidur);

      // 1. Calories vs BMR vs Target Chart
      const ctxCal = document.getElementById('caloriesChart').getContext('2d');
      if (caloriesChartInstance) caloriesChartInstance.destroy();

      caloriesChartInstance = new Chart(ctxCal, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Asupan Kalori (kkal)',
              data: calories,
              backgroundColor: 'rgba(245, 158, 11, 0.75)',
              borderColor: '#f59e0b',
              borderWidth: 1.5,
              borderRadius: 6
            },
            {
              label: 'Ambang BMR (1,118 kkal)',
              data: Array(logData.length).fill(clientTargets.bmr),
              type: 'line',
              borderColor: '#ef4444',
              borderWidth: 2,
              borderDash: [4, 4],
              pointRadius: 0,
              fill: false
            },
            {
              label: 'Target Defisit (1,473 kkal)',
              data: Array(logData.length).fill(clientTargets.targetCal),
              type: 'line',
              borderColor: '#16a34a',
              borderWidth: 2,
              borderDash: [2, 2],
              pointRadius: 0,
              fill: false
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 } } }
          },
          scales: {
            y: { beginAtZero: false, min: 600, max: 1800 }
          }
        }
      });

      // 2. Protein Doughnut Gauge Chart
      const ctxProtein = document.getElementById('proteinGaugeChart').getContext('2d');
      if (proteinGaugeChartInstance) proteinGaugeChartInstance.destroy();

      const avgProteinVal = parseFloat((logData.reduce((acc, d) => acc + d.protein, 0) / logData.length).toFixed(1));
      const remainingProtein = Math.max(0, clientTargets.targetProtein - avgProteinVal);

      proteinGaugeChartInstance = new Chart(ctxProtein, {
        type: 'doughnut',
        data: {
          labels: ['Rata-rata Tercapai (g)', 'Kekurangan (g)'],
          datasets: [{
            data: [avgProteinVal, remainingProtein],
            backgroundColor: ['#16a34a', '#e2e8f0'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '75%',
          plugins: {
            legend: { display: false }
          }
        }
      });

      // 3. Activity Chart
      const ctxAct = document.getElementById('activityChart').getContext('2d');
      if (activityChartInstance) activityChartInstance.destroy();

      activityChartInstance = new Chart(ctxAct, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Durasi Latihan (menit)',
              data: durations,
              backgroundColor: 'rgba(59, 130, 246, 0.7)',
              borderRadius: 6,
              yAxisID: 'y'
            },
            {
              label: 'Skala RPE (1-10)',
              data: rpes,
              type: 'line',
              borderColor: '#8b5cf6',
              backgroundColor: '#8b5cf6',
              borderWidth: 2,
              pointRadius: 4,
              yAxisID: 'y1'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { type: 'linear', position: 'left', min: 0, max: 90 },
            y1: { type: 'linear', position: 'right', min: 0, max: 10, grid: { drawOnChartArea: false } }
          }
        }
      });

      // 4. Recovery & Hydration Chart
      const ctxRec = document.getElementById('recoveryChart').getContext('2d');
      if (recoveryChartInstance) recoveryChartInstance.destroy();

      recoveryChartInstance = new Chart(ctxRec, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Air Putih (L)',
              data: waters,
              borderColor: '#0284c7',
              backgroundColor: 'rgba(2, 132, 199, 0.1)',
              fill: true,
              tension: 0.3
            },
            {
              label: 'Durasi Tidur (Jam)',
              data: sleeps,
              borderColor: '#6366f1',
              backgroundColor: 'rgba(99, 102, 241, 0.1)',
              fill: true,
              tension: 0.3
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { beginAtZero: true, max: 10 }
          }
        }
      });
    }

    // MODAL CONTROL
    function openAddModal() {
      document.getElementById('addModal').classList.remove('hidden');
      document.getElementById('addModal').classList.add('flex');
    }

    function closeAddModal() {
      document.getElementById('addModal').classList.add('hidden');
      document.getElementById('addModal').classList.remove('flex');
    }

    // HANDLE FORM SUBMISSION
    function handleFormSubmit(e) {
      e.preventDefault();

      const newEntry = {
        tanggal: document.getElementById('input-tanggal').value,
        bb: document.getElementById('input-bb').value ? parseFloat(document.getElementById('input-bb').value) : null,
        kalori: parseInt(document.getElementById('input-kalori').value),
        protein: parseInt(document.getElementById('input-protein').value),
        air: parseFloat(document.getElementById('input-air').value),
        tidur: parseFloat(document.getElementById('input-tidur').value),
        latihanType: document.getElementById('input-latihan-type').value,
        durasi: document.getElementById('input-durasi').value ? parseInt(document.getElementById('input-durasi').value) : 0,
        rpe: document.getElementById('input-rpe').value ? parseInt(document.getElementById('input-rpe').value) : 0,
        catatan: document.getElementById('input-catatan').value
      };

      logData.push(newEntry);

      updateDashboardData();
      renderMonitoringTable();
      renderCharts();
      closeAddModal();
      showToast('Data log harian Bu Lia berhasil diperbarui!');
    }

    // TOAST NOTIFICATION
    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-message').innerText = message;
      toast.classList.remove('translate-y-20', 'opacity-0');
      
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3500);
    }
  </script>
</body>
</html>